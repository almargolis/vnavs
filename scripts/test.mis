/begin

/msg:cameraman/orders
loop_mode=run
loop_format=jpeg
loop_publish=file
capture_mode=run
capture_format'=jpeg
capture_publish=file
iso=700

/msg:cameraman/process
Type=clear

/msg:cameraman/process
Type=line
x1=30
y1=-170
x2=120
y2=-50
process=WEY
colors=W

/sleep:5

/end

/msg:cameraman/orders
loop_mode=idle
